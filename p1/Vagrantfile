# Eval (42 x86): centos/7 — required by the subject.
# Local dev (Apple Silicon): bento/rockylinux-9 (ARM64, RHEL-compatible).
# Override: IOT_BOX=centos/7 vagrant up
IOT_BOX = ENV.fetch("IOT_BOX") {
  `uname -m`.strip == "arm64" ? "bento/rockylinux-9" : "generic/centos9s"
}

Vagrant.configure("2") do |config|

      if Vagrant.has_plugin?("vagrant-vbguest")
        config.vbguest.auto_update = false
    end
    
    config.vm.box = IOT_BOX
    config.vm.synced_folder ".", "/vagrant", type: "virtualbox"

    config.vm.define "bwongS" do |master|
        master.vm.hostname = "bwongS"
        master.vm.network "private_network",
            ip: "192.168.56.110",
            netmask: "255.255.255.0",
            auto_config: true
        master.vm.provider "virtualbox" do |vb|
            vb.name = "bwongS"
            vb.memory = "1024"
            vb.cpus = 1
        end

        master.vm.provision "shell", path: "scripts/centos-setup.sh"
        master.vm.provision "shell", path: "scripts/k3s-master.sh"
    end

    config.vm.define "bwongSW" do |worker|
        worker.vm.hostname = "bwongSW"
        worker.vm.network "private_network",
            ip: "192.168.56.111",
            netmask: "255.255.255.0",
            auto_config: true
        worker.vm.provider "virtualbox" do |vb|
            vb.name = "bwongSW"
            vb.memory = "1024"
            vb.cpus = 1
        end

        worker.vm.provision "shell", path: "scripts/centos-setup.sh"
        worker.vm.provision "shell", path: "scripts/k3s-worker.sh", args: ["192.168.56.110"]
    end
end
